# ─── Application ──────────────────────────────────────────────
NODE_ENV=development

# ─── apps/web ─────────────────────────────────────────────────
PORT=3000

# ─── apps/api ─────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Origins allowed to call the API with credentials, comma-separated. The
# session cookie only travels if the calling origin is listed here.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Where the front-end apps reach the backend. NEXT_PUBLIC_ is the one the
# browser sees; the unprefixed one is used for server-side calls, which on a
# container network is a different host.
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Where the product itself is served. The admin panel builds the link a
# published form is answered at from this — /forms/{id} lives in apps/web.
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────
# Sign-in is passwordless: the user enters a mobile number and a 4-digit code
# is sent to it. Everything below belongs to apps/api, which owns the codes,
# the users and the sessions.

# Session cookie lifetime, in days.
SESSION_MAX_AGE_DAYS=7
# Leave empty for a host-only cookie, which is what localhost wants. In
# production the API and the web app are sibling hosts, so the cookie has to be
# scoped to the parent domain — e.g. .hamdastan.ir
SESSION_COOKIE_DOMAIN=

# How long a code stays usable, in seconds. Also the length of the countdown
# the user sees and of the resend cooldown.
OTP_TTL_SECONDS=120
# Wrong codes allowed before the challenge locks and a new code is needed.
OTP_MAX_ATTEMPTS=5
# Codes one number may be sent inside OTP_SEND_WINDOW_MINUTES.
OTP_MAX_SENDS=5
OTP_SEND_WINDOW_MINUTES=15

# Echoes the generated code back in the API response, so the login flow can be
# walked without an SMS gateway and the e2e tests can sign in. The backend
# ignores it when NODE_ENV=production — never rely on it shipping disabled.
SHOW_DEV_OTP=true

# Which gateway adapter apps/api binds for every message the product sends —
# one-time codes and admin credentials alike. `mock` writes the message to the
# log instead of sending it; no SMS gateway is contracted yet.
SMS_PROVIDER=mock

# ─── Admin panel ──────────────────────────────────────────────
# apps/admin signs in with a username and a password, unlike the product
# itself. Admin accounts are created by other admins — there is no
# registration — and everything below belongs to apps/api, which owns the
# accounts, the passwords and the sessions.

# Admin session lifetime, in hours. Shorter than a product session because an
# admin session can create other admins.
ADMIN_SESSION_MAX_AGE_HOURS=12
# Wrong passwords allowed before the account is locked...
ADMIN_LOGIN_MAX_ATTEMPTS=5
# ...and how long that lock lasts, in minutes.
ADMIN_LOGIN_LOCK_MINUTES=15
# How long a generated temporary password stays usable, in hours. After that
# the account needs a reset — a password is never re-sent.
ADMIN_TEMP_PASSWORD_TTL_HOURS=48
# Echoes a generated temporary password back in the API response, so an admin
# account can be created and used without an SMS gateway. The backend ignores
# it when NODE_ENV=production — never rely on it shipping disabled.
SHOW_DEV_CREDENTIALS=true

# In development, apps/api seeds one admin so the panel has a way in:
#   username: Admin   password: Admin1234
# It starts owing a password change, and it is not seeded in production.

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────
# No database, ORM or data-persistence technology has been chosen yet. The
# repositories in apps/api/src/modules/*/*.repository.ts are the seam it will
# plug into — apps/api/src/modules/auth/auth.repository.ts holds an in-memory
# implementation until then, so users and sessions are lost on every restart.
# When one is picked, its connection string goes here.
# DATABASE_URL=
