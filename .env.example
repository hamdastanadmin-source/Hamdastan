# ─── Application ──────────────────────────────────────────────
NODE_ENV=development

# ─── apps/web ─────────────────────────────────────────────────
PORT=3000
# Session cookie lifetime in days
SESSION_MAX_AGE_DAYS=7
# Bypass the login screen entirely and run as the mock admin user. With this
# on there is no way to sign out — getSession() always returns the mock user,
# so /login bounces straight back to /. Leave it false to use the real flow.
SKIP_AUTH=false

# ─── apps/api ─────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Origins allowed to call the API with credentials, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Where the front-end apps reach the backend. NEXT_PUBLIC_ is the one the
# browser sees; the unprefixed one is used for server-side calls, which on a
# container network is a different host.
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────
# No database, ORM or data-persistence technology has been chosen yet. The
# repositories in apps/api/src/modules/*/*.repository.ts are the seam it will
# plug into. When one is picked, its connection string goes here.
# DATABASE_URL=
