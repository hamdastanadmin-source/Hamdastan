# ─── Application ──────────────────────────────────────────────
NODE_ENV=development

# ─── apps/web ─────────────────────────────────────────────────
PORT=3000

# ─── apps/api ─────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Origins allowed to call the API with credentials, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Where the front-end apps reach the backend. NEXT_PUBLIC_ is the one the
# browser sees; the unprefixed one is used for server-side calls, which on a
# container network is a different host.
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ─── Auth ─────────────────────────────────────────────────────
# Sign-in is passwordless: the user enters a mobile number and a 6-digit code
# is sent to it. Verifying that code is what creates the account — there is no
# separate registration. apps/api owns the codes, the users and the sessions.
#
# The lifetimes, the code length, the two-minute expiry, the attempt cap and
# the send limits are NOT environment variables. They live in
# `packages/config/app/auth.config.ts`, because the browser has to count down
# the same two minutes the server enforces and offer exactly the years the
# server accepts — a value only one side could change is a value that drifts.

# `Secure` on the session cookies. Leave unset to follow NODE_ENV: off in
# development, where http://localhost would otherwise drop every cookie.
# COOKIE_SECURE=false
# Leave empty for host-only cookies, which is what localhost and the deployed
# single-origin stack both want. Set it only when the app and the API are
# reached on different hostnames.
COOKIE_DOMAIN=

# Returns the one-time code in the API response, and through it onto the
# verification screen, in place of an SMS. It is what makes the sign-in flow
# walkable before the SMS provider is connected; turning it off is the whole
# deployment step on the day it is. With it on, anyone who can ask for a code
# for a number can also read it.
OTP_DEBUG_DISPLAY=true

# Which adapter apps/api sends one-time codes through. `console` writes the
# code to the log instead of sending it; `kavenegar` sends it and needs both
# variables below.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL, reached through `pg`. apps/api is the only workspace that may
# import the driver — that is what keeps the front-end unable to reach storage
# (RULES.md §3). The schema lives in database/migrations/ and is applied with
# `npm run db:migrate`.
#
# Leave DATABASE_URL empty and the API still boots: repositories stay unbound
# and answer 501, and /health reports the database as "skipped".
#
# Percent-encode any @ : / ? # in the password — they are the URL's own
# delimiters. An @ in a password reads as the start of the hostname.
DATABASE_URL=postgresql://tTFRlaeIQ9@R4Wi3rVqVR-QK@host:5432/database

# TLS to the database. Turn it on wherever the server offers it; the managed
# instance this project currently points at does not, so its credentials and
# rows travel in clear text.
DATABASE_SSL=false

DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Apply pending migrations during API boot instead of as a separate step.
# Convenient for a single-container deployment; leave it off where several
# instances start at once and a migration is a deliberate, reviewed act.
DATABASE_MIGRATE_ON_BOOT=false

# The API integration suite (`npm test`) runs against this database, and
# drops and recreates its schema every run — so it must be a throwaway one,
# and its name must end in `_test` or the suite refuses it. Never point it at
# DATABASE_URL. Left empty, those tests skip.
#   createdb hamdastan_test
TEST_DATABASE_URL=
