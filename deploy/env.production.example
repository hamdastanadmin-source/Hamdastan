# The environment the deployed stack runs with. Copy to deploy/.env.production
# — which is gitignored, holds real credentials, and is what
# `scripts/deploy.sh` uploads to the server as its .env.
#
# It is a separate file from the repository root's .env on purpose: that one
# is a developer's machine, with NODE_ENV=development, localhost URLs and the
# development one-time-code echo switched on. Sending it to a server would
# ship all three.

# ─── Where this deploys to ────────────────────────────────────
# Read by scripts/deploy.sh only; the containers ignore them. A variable
# already set in your shell wins over the value here.
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=root
DEPLOY_PATH=/srv/hamdastan

# ─── Application ──────────────────────────────────────────────
NODE_ENV=production

# Where the stack is reached from a browser. nginx serves the product at /
# and the API at /api/v1, so this is one origin with no port, and both the
# browser bundle and the CORS allow-list are built from it.
#
# Changing it means a redeploy — the browser bundle has to be rebuilt. The
# domain also appears in deploy/nginx.conf (server_name and certificate path).
PUBLIC_BASE_URL=https://hamdaastaan.ir

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_MIGRATE_ON_BOOT=true

# ─── Auth ─────────────────────────────────────────────────────
# Token lifetimes, code length, expiry, attempt caps and send limits are not
# environment variables — see packages/config/app/auth.config.ts. What is
# configurable here is where the cookies are valid and how a code is sent.

# The stack is one origin behind nginx, so host-only cookies are both correct
# and the narrower choice. Set this only if the app and the API ever move to
# different hostnames.
COOKIE_DOMAIN=

# Cookies are Secure by default in production, which is right behind TLS.
# Only if the site is ever served on plain http:// again, set
# COOKIE_SECURE=false — a browser drops a Secure cookie over HTTP and sign-in
# then silently fails.

# The development echo, off. With NODE_ENV=production the API still starts
# with it on and warns loudly, so that the sign-in flow can be exercised on
# the server in the window before the SMS provider is connected — turn it off
# the day SMS_PROVIDER becomes `kavenegar`.
OTP_DEBUG_DISPLAY=false

# Production needs `kavenegar` and both variables below. With `console` the
# API still boots, but fails closed: every request for a code answers 503 and
# nobody can sign in. The code is never returned or logged in production.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# ─── Admin panel ──────────────────────────────────────────────
# Nothing to set. The admin panel signs in with the same one-time codes as
# the product (see OTP_DEBUG_DISPLAY / SMS_PROVIDER above); its 12-hour
# session lives in packages/config/app/admin.config.ts.

# ─── Gateway ──────────────────────────────────────────────────
# nginx reaches the API over its own `edge` network at a fixed address, and
# the API trusts X-Forwarded-For from that address alone (docker-compose.prod.yml
# sets TRUST_PROXY from it). Change these only if the range collides with a
# network already on the host.
# EDGE_SUBNET=10.250.250.0/29
# NGINX_EDGE_IP=10.250.250.2

# ─── Rate limits, timeouts, retention ─────────────────────────
# All optional; the defaults are in apps/api/src/config/env.ts and docs/PRD.md
# §10. Tune after load testing, not before.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_USER_WRITE_PER_MINUTE=100
# RATE_LIMIT_USER_READ_PER_MINUTE=300
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
# RATE_LIMIT_REFRESH_PER_MINUTE=10
# RATE_LIMIT_SUBMIT_PER_MINUTE=5
# RATE_LIMIT_OTP_VERIFY_PER_15_MINUTES=30
# RATE_LIMIT_ADMIN_READ_PER_MINUTE=120
# RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=30
# OTP_MAX_FAILURES=5
# OTP_FAILURE_WINDOW_SECONDS=900
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# SMS_TIMEOUT_MS=5000
# SESSION_RETENTION_DAYS=90
# OTP_SEND_RETENTION_DAYS=30
# Session lifetime overrides, in seconds — for an incident, not routine use:
# SESSION_IDLE_TTL_SECONDS=604800
# SESSION_ABSOLUTE_TTL_SECONDS=2592000
# ADMIN_SESSION_IDLE_SECONDS=7200
