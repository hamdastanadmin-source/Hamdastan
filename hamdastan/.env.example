# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Auth (skeleton — no database yet) ────────────────────────
# Session cookie lifetime in days
SESSION_MAX_AGE_DAYS=7
# Bypass the login screen entirely and run as the mock admin user.
# Useful for UI development. Set to false to exercise the login flow.
SKIP_AUTH=true

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────
# No database / ORM is wired up yet. When one is added, its
# connection string goes here.
# DATABASE_URL=
